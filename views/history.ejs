<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>📜 Match History | Resume Score Checker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="container">
    <h1>📜 Your Match History</h1>

    <% if (!items || items.length === 0) { %>
      <div class="no-history">
        <p>No match history yet 😅</p>
        <a href="/match" class="btn">🚀 Start Matching</a>
      </div>
    <% } else { %>
      <div class="table-wrapper">
        <table class="history-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Date</th>
              <th>Score</th>
              <th>Present Skills</th>
              <th>Missing Skills</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((match, index) => { %>
              <tr>
                <td><%= (currentPage - 1) * 10 + index + 1 %></td>
                <td><%= new Date(match.createdAt).toLocaleString() %></td>
                <td class="score <%= match.score >= 70 ? 'high' : (match.score >= 40 ? 'medium' : 'low') %>">
                  <%= match.score %>%
                </td>
                <td><%= match.presentSkills.join(", ") || "None" %></td>
                <td><%= match.missingSkills.join(", ") || "None" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- === Pagination Controls === -->
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>" class="page-btn">⬅ Prev</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="?page=<%= i %>" 
             class="page-btn <%= i === currentPage ? 'active' : '' %>">
            <%= i %>
          </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>" class="page-btn">Next ➡</a>
        <% } %>
      </div>
    <% } %>

    <div class="btn-group">
      <a href="/match" class="btn">🔙 Back to Matcher</a>
    </div>
  </main>
</body>
</html>