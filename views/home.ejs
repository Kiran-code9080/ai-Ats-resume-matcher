<section class="home-section">
  <h1>Welcome, <%= user.name %> 👋</h1>
  <p>Your dashboard overview appears here.</p>

  <div class="ats-split-panel">
    <div class="ats-info">
      <h2>📄 Resume Score (ATS)</h2>
      <p>
        Evaluate your resume’s compatibility with job descriptions and applicant tracking systems.
      </p>
      <ul>
        <li>🔍 Keyword optimization</li>
        <li>📐 Layout and formatting check</li>
        <li>📊 Real-time scoring insights</li>
      </ul>
      <a href="/match" class="ats-link">Learn More →</a>
    </div>

    <div class="ats-action">
