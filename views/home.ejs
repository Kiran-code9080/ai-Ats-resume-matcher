    flex: 1;
    padding: 24px;
    min-width: 280px;
  }

  .ats-info {
    background: #f7f9fc;
  }

  .ats-info h2 {
    font-size: 1.5em;
    margin-bottom: 10px;
  }

  .ats-info p {
    margin-bottom: 12px;
    color: #333;
  }

  .ats-info ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 16px;
  }

  .ats-info ul li {
    margin-bottom: 8px;
    font-size: 0.95em;
  }

  .ats-link {
    text-decoration: none;
    color: #0077cc;
